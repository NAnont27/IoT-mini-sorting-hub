MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=hub
MQTT_PASSWORD=CHANGE_ME
INFLUX_URL=http://127.0.0.1:8086
INFLUX_ORG=mini-sort
INFLUX_BUCKET=bench
INFLUX_TOKEN=CHANGE_ME
# Set 0 only for initial bring-up; UI explicitly reports disabled history service.
INFLUX_ENABLED=1
# Local bench only: no public exposure or port forwarding.
WEB_HOST=0.0.0.0
WEB_PORT=5000

# Camera Module 3 preview on the dashboard (1 = on, 0 = off)
CAMERA_ENABLED=1
# Dashboard preview = full frame / this factor (3 -> 640x360); OCR always uses the full frame
CAMERA_PREVIEW_SCALE=3
